# Copy to backend/.env for local development. Never commit backend/.env.
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# MongoDB Atlas. Replace placeholders locally; URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://strategy_engine_app:<URL_ENCODED_PASSWORD>@<YOUR_ATLAS_HOST>/strategy_engine?retryWrites=true&w=majority
# MONGO_URL is also supported as an alternative to MONGODB_URI.

# Generate unique secrets locally with: openssl rand -hex 32
JWT_ACCESS_SECRET=<GENERATE_A_RANDOM_SECRET>
JWT_REFRESH_SECRET=<GENERATE_A_DIFFERENT_RANDOM_SECRET>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DeepSeek generates text and structured JSON for the existing workflow.
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: only set a fallback model if enabled for your API account and cost is approved.
# DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-pro
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=8192
# Optional override for compatible gateways; usually leave the official default.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Web search and webpage extraction.
TAVILY_API_KEY=<YOUR_TAVILY_API_KEY>
FIRECRAWL_API_KEY=<YOUR_FIRECRAWL_API_KEY>
RESEARCH_TIMEOUT_MS=45000
MAX_SOURCES=20
TAVILY_MAX_RESULTS_PER_TASK=4
BROWSE_CONCURRENCY=5
EXTRACTION_PROMPT_CONTENT_CHARS=12000

# Qdrant semantic-search service.
QDRANT_URL=<YOUR_QDRANT_HTTPS_ENDPOINT>
QDRANT_API_KEY=<YOUR_QDRANT_API_KEY>
EMBEDDING_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX

# General limits and optional MongoDB network troubleshooting.
RATE_LIMIT_PER_MINUTE=120
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
# Local troubleshooting only; never enable in production.
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false
# Optional if SRV DNS resolution fails on the local network.
# DNS_SERVERS=8.8.8.8,1.1.1.1
